exports[`JSON > expands input embedded in Markdown 1`] = `
"\`\`\`json
{
  // Comment 1
  "foo": [
    1,
    2
  ],
  "bar": /* Comment 2 */ [
    3
  ],
  // Comment 3
  "baz": {
    "qux": [
      4
    ]
  },
  "quux": [], // Comment 4
  "corge": {},
  "grault": [
    {
      "garply": 5,
      "waldo": 6
    },
    {
      "fred": 7,
      "plugh": 8
    }
  ],
  "xyzzy": {
    "thud": 9
  }
}
\`\`\`
"
`;

