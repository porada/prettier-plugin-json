{
	"name": "prettier-plugin-json",
	"version": "1.2.1",
	"description": "Additional JSON and JSONC formatting options for Prettier",
	"license": "MIT",
	"author": {
		"name": "Dom Porada",
		"email": "dom@dom.engineering",
		"url": "https://dom.engineering"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/porada/prettier-plugin-json.git"
	},
	"keywords": [
		"formatting",
		"json",
		"jsonc",
		"prettier",
		"prettier-plugin",
		"prettier-plugin-expand-json"
	],
	"files": [
		"dist/**"
	],
	"type": "module",
	"sideEffects": false,
	"exports": "./dist/index.mjs",
	"types": "./dist/index.d.mts",
	"engines": {
		"node": ">=22"
	},
	"packageManager": "pnpm@12.23.0",
	"peerDependencies": {
		"prettier": ">=3"
	},
	"devDependencies": {
		"@standard-config/oxlint": "^2.12.0",
		"@standard-config/oxlint-stylistic": "^2.13.0",
		"@standard-config/prettier": "^1.23.1",
		"@standard-config/tsconfig": "^3.2.0",
		"@vitest/coverage-v8": "5.1.0",
		"prettier": "^3.10.1",
		"prettier-plugin-sort-json": "^4.2.0",
		"publint": "^0.3.25",
		"typescript": "^6.0.3",
		"vite-plus": "^1.7.0"
	},
	"scripts": {
		"build": "vp pack",
		"fix": "pnpm build && pnpm format && pnpm lint && pnpm format",
		"format": "prettier --ignore-unknown --log-level=warn --write .",
		"format:check": "prettier --check --ignore-unknown .",
		"lint": "vp lint --fix",
		"lint:check": "vp lint --deny-warnings --type-check",
		"prepack": "pnpm build && pnpm run '/^(format:check|lint:check|test|typecheck)$/'",
		"prepare": "vp config --hooks-dir .hooks",
		"postprepare": "pnpm build",
		"test": "vp test",
		"typecheck": "tsc --noEmit"
	}
}
